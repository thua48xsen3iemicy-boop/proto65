#!/sbin/openrc-run
# Протокол 65 — сервер игры. Установка: cp deploy/proto65.openrc /etc/init.d/proto65

name="proto65"
description="Протокол 65: игра и панель ведущей"

: ${PROTO65_DIR:=/opt/proto65}
: ${PROTO65_USER:=proto65}
: ${PROTO65_ENV:=/etc/proto65.env}
: ${PROTO65_DATA:=/var/lib/proto65}

supervisor=supervise-daemon
command="/usr/bin/node"
command_args="--env-file=${PROTO65_ENV} ${PROTO65_DIR}/server/index.js"
command_user="${PROTO65_USER}:${PROTO65_USER}"
directory="${PROTO65_DIR}"
output_log="/var/log/proto65/proto65.log"
error_log="/var/log/proto65/proto65.log"
respawn_delay=2

depend() {
	need net
	use nginx
}

start_pre() {
	checkpath -f -m 0640 -o root:${PROTO65_USER} "${PROTO65_ENV}" || return 1
	checkpath -d -m 0750 -o ${PROTO65_USER}:${PROTO65_USER} /var/log/proto65 "${PROTO65_DATA}"
}
