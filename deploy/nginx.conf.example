# Пример для nginx. Socket.IO нужен проброс WebSocket (заголовки Upgrade/Connection).

# В блок http { … } — один раз на весь nginx:
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    server_name proto65.example.ru;
    # ssl_certificate / ssl_certificate_key …

    # Вариант 1: игра в корне сайта — https://proto65.example.ru/ и /admin
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;   # соединение с игрой держится весь урок
    }

    # Вариант 2: игра в подкаталоге — https://example.ru/proto65/ и /proto65/admin
    # (слеш в конце proxy_pass обязателен: он убирает префикс /proto65/)
    #
    # location = /proto65 { return 301 /proto65/; }
    # location /proto65/ {
    #     proxy_pass http://127.0.0.1:3000/;
    #     proxy_http_version 1.1;
    #     proxy_set_header Upgrade $http_upgrade;
    #     proxy_set_header Connection $connection_upgrade;
    #     proxy_set_header Host $host;
    #     proxy_read_timeout 1h;
    # }
}
