# Настройки сервера «Протокол 65». Скопируйте в /etc/proto65.env и задайте свой PIN.
# Права: chown root:proto65 /etc/proto65.env && chmod 640 /etc/proto65.env

# PIN-код панели ведущей (/admin), 4–12 цифр
ADMIN_PIN=

# Адрес и порт, на которых слушает Node.js (наружу смотрит обратный прокси)
HOST=127.0.0.1
PORT=3000

# Где хранить сеансы и результаты
DATA_DIR=/var/lib/proto65
